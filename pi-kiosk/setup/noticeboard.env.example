# Hockley Mint notice board - shared configuration for all services.
# install.sh copies this to /etc/noticeboard.env. Edit there, then:
#   sudo systemctl restart noticeboard-watch noticeboard-server noticeboard-kiosk

# Kiosk web root (the folder containing index.html). Set by install.sh.
WEBROOT=/opt/noticeboard/display

# The watched PowerPoint on the mounted share.
# The Windows side is  S:\NoticeBoard\board.pptx
# The Pi mounts that same share at /mnt/noticeboard (see setup/mount-share.md),
# so the deck the Pi watches is:
DECK_PATH=/mnt/noticeboard/board.pptx

# How long each slide shows, in milliseconds.
SLIDE_DURATION_MS=12000

# How often the Pi checks the share for a new deck, in seconds.
POLL_SECONDS=20

# Local web server bind + port (kept on loopback; never exposed to the network).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# URL the kiosk browser opens.
KIOSK_URL=http://127.0.0.1:8080/

# The Linux user the services run as (created/used by install.sh).
KIOSK_USER=noticeboard

# Weather (fetched server-side by agent/fetch-weather.py via api.met.no, since
# this network blocks api.open-meteo.com). Written to WEATHER_OUT in the webroot.
WEATHER_LAT=52.4862
WEATHER_LON=-1.8904
WEATHER_LABEL=Birmingham
WEATHER_OUT=/opt/noticeboard/display/weather.json

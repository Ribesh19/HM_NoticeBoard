[Unit]
Description=Hockley Mint notice board - kiosk display (cage + Chromium)
After=noticeboard-server.service systemd-user-sessions.service
Wants=noticeboard-server.service

[Service]
EnvironmentFile=/etc/noticeboard.env
User=noticeboard
# PAMName=login makes logind set up a full session (incl. XDG_RUNTIME_DIR),
# which the cage Wayland compositor needs to grab the seat and display.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# cage runs exactly one app, fullscreen, with no window chrome - ideal kiosk.
ExecStart=/usr/bin/cage -- /opt/noticeboard/agent/start-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
